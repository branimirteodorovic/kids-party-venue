{
  "permissions": {
    "allow": [
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet ef migrations:*)",
      "Bash(dotnet format:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "PowerShell(dotnet build:*)",
      "PowerShell(dotnet test:*)",
      "PowerShell(dotnet ef migrations:*)",
      "PowerShell(dotnet format:*)",
      "PowerShell(docker compose ps:*)",
      "PowerShell(docker compose logs:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-migrations.ps1\""
          }
        ]
      }
    ]
  }
}
