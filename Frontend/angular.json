{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "schematicCollections": ["angular-eslint"]
  },
  "newProjectRoot": "projects",
  "projects": {
    "kids-party-venue": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": ["src/styles.css"],
            "server": "src/main.server.ts",
            "outputMode": "server",
            "security": {
              "allowedHosts": []
            },
            "ssr": {
              "entry": "src/server.ts"
            },
            "polyfills": ["@angular/localize/init"]
          },
          "configurations": {
            "production": {
              "localize": true,
              "i18nMissingTranslation": "warning",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "en": { "localize": ["en"] },
            "ru": { "localize": ["ru"] },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "kids-party-venue:build:production"
            },
            "development": {
              "buildTarget": "kids-party-venue:build:development"
            },
            "en": { "buildTarget": "kids-party-venue:build:development,en" },
            "ru": { "buildTarget": "kids-party-venue:build:development,ru" }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["src/**/*.ts", "src/**/*.html"]
          }
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": { "buildTarget": "kids-party-venue:build" }
        }
      },
      "i18n": {
        "sourceLocale": { "code": "sr-Latn", "subPath": "" },
        "locales": {
          "en": { "translation": "src/locale/messages.en.json", "subPath": "en" },
          "ru": { "translation": "src/locale/messages.ru.json", "subPath": "ru" }
        }
      }
    }
  }
}
